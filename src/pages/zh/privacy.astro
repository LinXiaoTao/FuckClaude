---
import TrustPageShell from '../../components/TrustPageShell.astro';
import { TRUST_CONTENT } from '../../content/trust';
import { useTranslations } from '../../i18n/ui';

const lang = 'zh';
const t = useTranslations(lang);
---

<TrustPageShell
  lang={lang}
  path="/zh/privacy/"
  enPath="/privacy/"
  zhPath="/zh/privacy/"
  title={t('trust.privacy.title')}
  description={t('trust.privacy.description')}
  body={TRUST_CONTENT.privacy.zh}
/>
