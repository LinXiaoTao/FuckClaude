---
import TrustPageShell from '../components/TrustPageShell.astro';
import { resolveTrustPageBody } from '../content/trust/resolve';
import { useTranslations } from '../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
---

<TrustPageShell
  lang={lang}
  path="/terms/"
  title={t('trust.terms.title')}
  description={t('trust.terms.description')}
  body={resolveTrustPageBody('terms', lang)}
/>
