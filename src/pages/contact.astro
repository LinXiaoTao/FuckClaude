---
import TrustPageShell from '../components/TrustPageShell.astro';
import { resolveTrustPageBody } from '../content/trust/resolve';
import { useTranslations } from '../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
---

<TrustPageShell
  lang={lang}
  path="/contact/"
  title={t('trust.contact.title')}
  description={t('trust.contact.description')}
  body={resolveTrustPageBody('contact', lang)}
/>
