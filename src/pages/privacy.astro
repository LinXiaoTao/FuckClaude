---
import TrustPageShell from '../components/TrustPageShell.astro';
import { resolveTrustPageBody } from '../content/trust/resolve';
import { useTranslations } from '../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
---

<TrustPageShell
  lang={lang}
  path="/privacy/"
  title={t('trust.privacy.title')}
  description={t('trust.privacy.description')}
  body={resolveTrustPageBody('privacy', lang)}
/>
