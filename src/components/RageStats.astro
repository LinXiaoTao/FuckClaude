---
/**
 * Counter card. Two instances sit in the hero panel:
 *   kind="smash" under the mascot: global hits, the visitor's own hits and a
 *                country ranking by hits.
 *   kind="scan"  under the score ring: global scans and a country ranking by
 *                scans.
 * Filled in by scripts/rage.ts from /api/stats. While the global store is
 * unavailable the script sets data-enabled="false" on every [data-stats]
 * element: the smash card keeps only the visitor's own count and the scan card
 * is hidden.
 */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  kind: 'smash' | 'scan';
}
const { lang, kind } = Astro.props;
const t = useTranslations(lang);
---

<section class="stats" data-stats data-kind={kind} data-enabled="false" aria-label={t(`rage.stat.${kind}`)}>
  <dl class="stats__row">
    <div class="stat stat--global">
      <dt class="stat__label">{t(`rage.stat.${kind}`)}</dt>
      <dd class="stat__num" id={`stat-${kind}`}>–</dd>
    </div>
    {
      kind === 'smash' && (
        <div class="stat stat--you">
          <dt class="stat__label">{t('rage.stat.you')}</dt>
          <dd class="stat__num stat__num--you" id="stat-you">0</dd>
        </div>
      )
    }
  </dl>

  <details class="stats__more stat--global">
    <summary>{t('rage.countries')}</summary>
    <ol class="stats__list" id={`top-${kind}`}></ol>
  </details>
</section>

<style>
  .stats {
    width: min(260px, 100%);
    margin-top: 14px;
    padding: 10px 14px 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
    text-align: center;
  }
  .stats[data-kind='scan'][data-enabled='false'] {
    display: none;
  }
  .stats[data-enabled='false'] .stat--global {
    display: none;
  }
  .stats__row {
    margin: 0;
    display: flex;
    justify-content: center;
  }
  .stat {
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    padding-inline: 6px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .stats[data-enabled='true'] .stat + .stat {
    border-inline-start: 1px solid var(--border);
  }
  .stat__label {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.03em;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .stat__num {
    margin: 2px 0 0;
    font-family: var(--mono);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .stat__num--you {
    color: var(--accent-strong);
  }
  .stat__num.is-bump {
    animation: stat-bump 0.18s ease-out;
  }
  @keyframes stat-bump {
    50% {
      transform: scale(1.14);
      color: var(--accent-strong);
    }
  }
  .stats__more {
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px dashed var(--border);
    text-align: start;
  }
  .stats__more summary {
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 650;
    color: var(--muted);
    text-align: center;
  }
  .stats__more summary:hover {
    color: var(--accent-strong);
  }
  .stats__list {
    margin: 6px 0 2px;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
  }
  .stats__list :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 2px 0;
    overflow-wrap: anywhere;
  }
  .stats__list :global(li span:last-child) {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .stats__list :global(li.is-empty) {
    color: var(--muted-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .stat__num.is-bump {
      animation: none;
    }
  }
</style>
