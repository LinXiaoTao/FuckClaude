---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import Footer from './Footer.astro';
import IpPurityCard from './IpPurityCard.astro';
import { localePath, type Lang } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, '/');
const path = localePath(lang, '/ip/');

const site = Astro.site ?? new URL('https://fuck-claude.vercel.app');
const currentUrl = new URL(path, site).href;
const homeUrl = new URL(home, site).href;
const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: homeUrl },
    { '@type': 'ListItem', position: 2, name: t('ip.title'), item: currentUrl },
  ],
};
---

<BaseLayout
  lang={lang}
  path={path}
  title={`${t('ip.meta.title')} | Fuck Claude`}
  description={t('ip.meta.description')}
  omitFaq
  jsonLdExtra={breadcrumbJsonLd}
>
  <SiteHeader lang={lang} current="ip" />

  <main class="wrap">
    <section class="ip-hero">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={home}>{t('nav.home')}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{t('ip.title')}</li>
        </ol>
      </nav>
      <h1>{t('ip.title')}</h1>
      <p class="ip-hero__lead">{t('ip.lead')}</p>
    </section>
    <IpPurityCard lang={lang} variant="page" />
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .ip-hero {
    padding: 36px 0 8px;
  }
  .breadcrumb {
    margin-bottom: 12px;
    font-size: 0.86rem;
  }
  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--muted-2);
  }
  .breadcrumb a {
    color: var(--muted);
    font-weight: 600;
  }
  .breadcrumb a:hover {
    color: var(--accent-strong);
  }
  .ip-hero h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 2.6rem);
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .ip-hero__lead {
    margin: 0;
    max-width: 68ch;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.55;
  }
</style>
