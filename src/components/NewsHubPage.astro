---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import Footer from './Footer.astro';
import ClaudeNews from './ClaudeNews.astro';
import CommunityPosts from './CommunityPosts.astro';
import I18nNotice from './I18nNotice.astro';
import { localePath, type Lang } from '../i18n/locales';
import { translationNoticeApplies } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, '/');
const newsHub = localePath(lang, '/news/');
const showNotice = translationNoticeApplies(lang, 'fallback');

const site = Astro.site ?? new URL('https://fuck-claude.vercel.app');
const currentUrl = new URL(newsHub, site).href;
const homeUrl = new URL(home, site).href;

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: homeUrl },
    { '@type': 'ListItem', position: 2, name: t('news.title'), item: currentUrl },
  ],
};
---

<BaseLayout
  lang={lang}
  path={newsHub}
  title={`${t('news.title')} | Fuck Claude`}
  description={t('news.sub')}
  omitFaq
  jsonLdExtra={breadcrumbJsonLd}
>
  <SiteHeader lang={lang} current="news" />

  <main class="wrap">
    <section class="news-hero">
      {showNotice && <I18nNotice lang={lang} />}
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={home}>{t('nav.home')}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{t('news.title')}</li>
        </ol>
      </nav>

      <h1>{t('news.title')}</h1>
      <p class="news-sub">{t('news.sub')}</p>
      <p class="news-note">{t('news.note')}</p>
    </section>

    <ClaudeNews lang={lang} />

    <div id="community-posts" style="scroll-margin-top: 80px;">
      <CommunityPosts lang={lang} />
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .news-hero {
    padding: 36px 0 16px;
  }
  .breadcrumb {
    margin-bottom: 12px;
    font-size: 0.86rem;
  }
  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--muted-2);
  }
  .breadcrumb a {
    color: var(--muted);
    font-weight: 600;
  }
  .breadcrumb a:hover {
    color: var(--accent-strong);
  }
  .news-hero h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .news-sub {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 65ch;
    margin: 0;
  }
  .news-note {
    font-size: 0.88rem;
    color: var(--muted-2);
    max-width: 65ch;
    margin: 12px 0 0;
    line-height: 1.55;
  }
</style>
