---
import BaseLayout from '../layouts/BaseLayout.astro';
import LangToggle from './LangToggle.astro';
import SocialLinks from './SocialLinks.astro';
import Footer from './Footer.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
  enPath: string;
  zhPath: string;
  title: string;
  description: string;
  body: string;
}

const { lang, path, enPath, zhPath, title, description, body } = Astro.props;
const t = useTranslations(lang);
const home = lang === 'zh' ? '/zh/' : '/';
const guidesHub = lang === 'zh' ? '/zh/guides/' : '/guides/';
const newsHub = lang === 'zh' ? '/zh/news/' : '/news/';
const extensionPage = lang === 'zh' ? '/zh/extension/' : '/extension/';
const prefix = lang === 'zh' ? '/zh' : '';

const site = Astro.site ?? new URL('https://fuck-claude.vercel.app');
const currentUrl = new URL(path, site).href;
const homeUrl = new URL(home, site).href;

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('nav.home'),
      item: homeUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: title,
      item: currentUrl,
    },
  ],
};
---

<BaseLayout
  lang={lang}
  {path}
  title={`${title} | Fuck Claude`}
  {description}
  {enPath}
  {zhPath}
  omitFaq
  jsonLdExtra={breadcrumbJsonLd}
>
  <header class="nav">
    <div class="wrap nav__inner">
      <a class="brand" href={home}>
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="currentColor"></rect>
          <g fill="#FAF9F5">
            <rect x="26.9" y="8" width="7.6" height="29" rx="3.8"></rect>
            <rect x="18.9" y="24.5" width="6.4" height="11" rx="3.2"></rect>
            <rect x="36.1" y="24.5" width="6.4" height="11" rx="3.2"></rect>
            <rect x="16.9" y="30" width="27.6" height="24" rx="9"></rect>
            <rect x="40.6" y="32.5" width="7.6" height="16" rx="3.8" transform="rotate(-24 44.4 40.5)"></rect>
          </g>
        </svg>
        <span class="brand__text">{t('nav.title')}</span>
      </a>
      <nav class="nav__actions">
        <a class="nav__link" href={home}>{t('nav.home')}</a>
        <a class="nav__link" href={guidesHub}>{t('nav.guides')}</a>
        <a class="nav__link" href={newsHub}>{t('nav.news')}</a>
        <a class="nav__link" href={extensionPage}>{t('nav.extension')}</a>
        <LangToggle lang={lang} />
        <SocialLinks lang={lang} />
      </nav>
    </div>
  </header>

  <main class="wrap">
    <article class="article">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={home}>{t('nav.home')}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>

      <header class="article__header">
        <h1>{title}</h1>
      </header>
      <div class="article__body prose" set:html={body} />

      <footer class="trust-nav">
        <h3>{lang === 'zh' ? '政策与信任导航' : 'Trust & Policies'}</h3>
        <div class="trust-nav__links">
          <a href={`${prefix}/privacy/`}>{t('footer.privacy')}</a>
          <a href={`${prefix}/terms/`}>{t('footer.terms')}</a>
          <a href={`${prefix}/about/`}>{t('footer.about')}</a>
          <a href={`${prefix}/contact/`}>{t('footer.contact')}</a>
        </div>
      </footer>
    </article>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .article {
    max-width: 820px;
    margin: 0 auto;
    padding: 32px 0 60px;
  }
  .breadcrumb {
    margin-bottom: 16px;
    font-size: 0.86rem;
  }
  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--muted-2);
  }
  .breadcrumb a {
    color: var(--muted);
    font-weight: 600;
  }
  .breadcrumb a:hover {
    color: var(--accent-strong);
  }
  .article__header {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }
  .article__header h1 {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.8vw, 2.5rem);
    line-height: 1.25;
    margin: 0;
  }
  .article__body {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--text);
  }
  .article__body :global(h2) {
    font-family: var(--serif);
    font-size: 1.35rem;
    margin: 32px 0 12px;
    padding-bottom: 4px;
    border-bottom: 1px dashed var(--border-strong);
  }
  .article__body :global(h2:first-child) {
    margin-top: 0;
  }
  .article__body :global(p) {
    margin: 0 0 16px;
    color: var(--text);
  }
  .article__body :global(ul) {
    margin: 0 0 18px;
    padding-left: 22px;
  }
  .article__body :global(li) {
    margin-bottom: 8px;
    color: var(--text);
  }
  .article__body :global(a) {
    color: var(--accent-strong);
  }
  .trust-nav {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .trust-nav h3 {
    font-size: 1.05rem;
    margin: 0 0 12px;
  }
  .trust-nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .trust-nav__links a {
    display: inline-flex;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .trust-nav__links a:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    text-decoration: none;
  }
</style>
