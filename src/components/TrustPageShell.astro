---
import BaseLayout from '../layouts/BaseLayout.astro';
import LangToggle from './LangToggle.astro';
import SocialLinks from './SocialLinks.astro';
import Footer from './Footer.astro';
import { localePath, type Lang } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
  title: string;
  description: string;
  body: string;
}

const { lang, path, title, description, body } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, '/');
const guidesHub = localePath(lang, '/guides/');
const newsHub = localePath(lang, '/news/');
const extensionPage = localePath(lang, '/extension/');

const site = Astro.site ?? new URL('https://fuck-claude.vercel.app');
const currentUrl = new URL(path, site).href;
const homeUrl = new URL(home, site).href;

const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: homeUrl },
    { '@type': 'ListItem', position: 2, name: title, item: currentUrl },
  ],
};
---

<BaseLayout lang={lang} {path} title={`${title} | Fuck Claude`} {description} omitFaq jsonLdExtra={breadcrumbJsonLd}>
  <header class="nav">
    <div class="wrap nav__inner">
      <a class="brand" href={home}>
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="currentColor"></rect>
          <g fill="#FAF9F5">
            <rect x="26.9" y="8" width="7.6" height="29" rx="3.8"></rect>
            <rect x="18.9" y="24.5" width="6.4" height="11" rx="3.2"></rect>
            <rect x="36.1" y="24.5" width="6.4" height="11" rx="3.2"></rect>
            <rect x="16.9" y="30" width="27.6" height="24" rx="9"></rect>
            <rect x="40.6" y="32.5" width="7.6" height="16" rx="3.8" transform="rotate(-24 44.4 40.5)"></rect>
          </g>
        </svg>
        <span class="brand__text">{t('nav.title')}</span>
      </a>
      <nav class="nav__actions">
        <a class="nav__link" href={home}>{t('nav.home')}</a>
        <a class="nav__link" href={guidesHub}>{t('nav.guides')}</a>
        <a class="nav__link" href={newsHub}>{t('nav.news')}</a>
        <a class="nav__link" href={extensionPage}>{t('nav.extension')}</a>
        <LangToggle lang={lang} />
        <SocialLinks lang={lang} />
      </nav>
    </div>
  </header>

  <main class="wrap trust-page">
    <article class="trust-article">
      <h1>{title}</h1>
      <div class="trust-body" set:html={body} />
    </article>

    <aside class="trust-aside">
      <nav aria-label="Trust pages">
        <h3>{t('trust.navTitle')}</h3>
        <ul>
          <li><a href={localePath(lang, '/about/')}>{t('footer.about')}</a></li>
          <li><a href={localePath(lang, '/privacy/')}>{t('footer.privacy')}</a></li>
          <li><a href={localePath(lang, '/terms/')}>{t('footer.terms')}</a></li>
          <li><a href={localePath(lang, '/contact/')}>{t('footer.contact')}</a></li>
        </ul>
      </nav>
    </aside>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .trust-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    padding: 36px 0 20px;
  }
  @media (min-width: 900px) {
    .trust-page {
      grid-template-columns: minmax(0, 1fr) min(260px, 28%);
      align-items: start;
    }
  }
  .trust-article h1 {
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.6vw, 2.4rem);
    margin: 0 0 16px;
  }
  .trust-body :global(h2) {
    font-size: 1.12rem;
    margin: 22px 0 8px;
  }
  .trust-body :global(p),
  .trust-body :global(li) {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .trust-body :global(ul) {
    padding-inline-start: 1.2rem;
  }
  .trust-aside {
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .trust-aside h3 {
    margin: 0 0 12px;
    font-size: 0.92rem;
  }
  .trust-aside ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .trust-aside a {
    font-weight: 600;
    color: var(--muted);
  }
</style>
