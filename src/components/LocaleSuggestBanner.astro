---
import { LOCALE_CODES, LOCALES, type Lang } from '../i18n/locales';
import { LOCALE_LABELS } from '../i18n/locale-labels';
import { useTranslations } from '../i18n/ui';

interface Props {
  currentLang: Lang;
  alternateUrls: Record<Lang, string>;
}

const { currentLang, alternateUrls } = Astro.props;
const t = useTranslations(currentLang);
const localeJson = JSON.stringify(
  Object.fromEntries(LOCALE_CODES.map((code) => [code, alternateUrls[code]])),
);
const labelsJson = JSON.stringify(LOCALE_LABELS);
---

<aside
  id="locale-banner"
  class="locale-banner"
  role="region"
  aria-label="Language recommendation banner"
  data-current-lang={currentLang}
  data-locale-urls={localeJson}
  data-locale-labels={labelsJson}
  style="display: none;"
>
  <div class="locale-banner-inner">
    <div class="locale-banner-text">
      <span id="locale-banner-message">{t('banner.prompt')}</span>
    </div>

    <div class="locale-banner-controls">
      <div class="locale-banner-select-wrapper">
        <svg class="locale-banner-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <select id="locale-banner-select" class="locale-banner-select" aria-label={t('lang.toggleLabel')}>
          {
            LOCALE_CODES.map((code) => (
              <option value={code}>{LOCALE_LABELS[code]}</option>
            ))
          }
        </select>
        <svg class="locale-banner-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <a id="locale-banner-continue" href={alternateUrls[currentLang]} class="locale-banner-button">
        {t('banner.continue')}
      </a>

      <button id="locale-banner-close" class="locale-banner-close" aria-label={t('banner.dismiss')} type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</aside>

<script is:inline>
  (() => {
    try {
      const banner = document.getElementById('locale-banner');
      if (!banner) return;

      const DISMISSED_KEY = 'apple_style_lang_banner_dismissed';
      if (sessionStorage.getItem(DISMISSED_KEY) === '1') {
        return;
      }

      const currentLang = banner.getAttribute('data-current-lang') || 'en';
      const urls = JSON.parse(banner.getAttribute('data-locale-urls') || '{}');

      function normalizeTag(tag) {
        return (tag || '').trim().toLowerCase().replace(/_/g, '-');
      }

      function pickFromNavigator() {
        const list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
        for (const raw of list) {
          const tag = normalizeTag(raw);
          if (tag in urls) return tag;
          if (tag === 'zh' || tag.startsWith('zh-')) return 'zh';
          const base = tag.split('-')[0];
          if (base in urls) return base;
        }
        return 'en';
      }

      const detectedLang = pickFromNavigator();
      if (detectedLang === currentLang) {
        return;
      }

      const select = document.getElementById('locale-banner-select');
      const continueBtn = document.getElementById('locale-banner-continue');
      const closeBtn = document.getElementById('locale-banner-close');

      if (select && urls[detectedLang]) {
        select.value = detectedLang;
      }

      function updateContinueTarget() {
        if (!select || !continueBtn) return;
        const target = urls[select.value] || urls.en || '/';
        continueBtn.setAttribute('href', target);
      }

      if (select) {
        select.addEventListener('change', updateContinueTarget);
      }

      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          banner.style.display = 'none';
          sessionStorage.setItem(DISMISSED_KEY, '1');
        });
      }

      updateContinueTarget();
      banner.style.display = 'block';
    } catch (e) {}
  })();
</script>

<style>
  .locale-banner {
    width: 100%;
    background-color: #f5f5f7;
    border-bottom: 1px solid #d2d2d7;
    color: #1d1d1f;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    line-height: 1.4;
    position: relative;
    z-index: 100;
  }

  .locale-banner-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .locale-banner-text {
    flex: 1 1 320px;
    color: #1d1d1f;
    font-weight: 400;
    text-align: start;
  }

  .locale-banner-controls {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .locale-banner-select-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    padding: 4px 28px 4px 28px;
    min-height: 32px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .locale-banner-check {
    position: absolute;
    inset-inline-start: 8px;
    width: 13px;
    height: 13px;
    color: #1d1d1f;
    pointer-events: none;
  }

  .locale-banner-chevron {
    position: absolute;
    inset-inline-end: 8px;
    width: 12px;
    height: 12px;
    color: #86868b;
    pointer-events: none;
  }

  .locale-banner-select {
    appearance: none;
    background: transparent;
    border: none;
    font-size: 13px;
    font-weight: 500;
    color: #1d1d1f;
    outline: none;
    cursor: pointer;
    padding-inline-end: 4px;
  }

  .locale-banner-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #1d1d1f;
    color: #ffffff;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.15s ease;
    min-height: 32px;
  }

  .locale-banner-button:hover {
    background-color: #333336;
  }

  .locale-banner-close {
    background: transparent;
    border: none;
    padding: 4px;
    margin-inline-start: 4px;
    color: #1d1d1f;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .locale-banner-close svg {
    width: 16px;
    height: 16px;
  }

  .locale-banner-close:hover {
    color: #000000;
  }

  .locale-banner-select:focus-visible,
  .locale-banner-button:focus-visible,
  .locale-banner-close:focus-visible {
    outline: 2px solid #0071e3;
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .locale-banner-inner {
      position: relative;
      flex-direction: column;
      align-items: flex-start;
      padding: 10px max(16px, env(safe-area-inset-right)) 12px max(16px, env(safe-area-inset-left));
      gap: 10px;
    }

    .locale-banner-text {
      flex: 0 1 auto;
      width: 100%;
      padding-inline-end: 44px;
    }

    .locale-banner-controls {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .locale-banner-select-wrapper {
      flex: 1;
      min-height: 40px;
      padding: 6px 30px 6px 28px;
    }

    .locale-banner-select {
      font-size: 16px;
      width: 100%;
    }

    .locale-banner-button {
      flex-shrink: 0;
      min-height: 40px;
      padding: 8px 18px;
      font-size: 14px;
    }

    .locale-banner-close {
      position: absolute;
      top: 2px;
      inset-inline-end: max(4px, env(safe-area-inset-right));
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px;
      margin-inline-start: 0;
      border-radius: 50%;
    }
  }
</style>
