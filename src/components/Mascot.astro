---
/**
 * Animated cartoon "Claude CEO" mascot. Five states, switched by
 * `data-state` on #mascot (driven from scripts/detect.ts):
 *   doze   – default, asleep (Zzz bubbles)
 *   search – scanning with a magnifying glass
 *   low    – smiling thumbs-up
 *   medium – suspicious stare
 *   high   – pointing a (toy) gun at you
 * Every state loops a CSS animation so the character is never static.
 *
 * The figure is also a button (hammer cursor, "click to hit" pill). On each
 * hit scripts/rage.ts swings a hammer, knocks the body back (.mascot__body),
 * shows dizzy stars, leaves plasters and, after a streak, tints the figure red
 * (data-hurt 1-3). The "hits" counter card sits under the figure.
 */
import { useTranslations, type Lang } from '../i18n/ui';
import RageStats from './RageStats.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const STATES = [
  { id: 'doze', src: '/mascot/ceo-doze.webp' },
  { id: 'search', src: '/mascot/ceo-search.webp' },
  { id: 'low', src: '/mascot/ceo-happy.webp' },
  { id: 'medium', src: '/mascot/ceo-suspect.webp' },
  { id: 'high', src: '/mascot/ceo-gun.webp' },
];
---

<div class="mascot" id="mascot" data-state="doze" data-hurt="0" data-engaged="false">
  <p class="mascot__bubble" id="mascot-bubble">{t('rage.hint')}</p>
  <button class="mascot__hit" id="mascot-hit" type="button" aria-label={t('rage.aria')}>
    <span class="mascot__stage" id="mascot-stage">
      <span class="mascot__body" id="mascot-body">
        {STATES.map((s) => <img class="mascot__fig" data-mstate={s.id} src={s.src} alt="" decoding="async" draggable="false" />)}
      </span>
      <span class="mascot__zzz"><i>Z</i><i>Z</i><i>Z</i></span>
      <span class="mascot__dizzy" aria-hidden="true"><i style="--i:0">💫</i><i style="--i:1">⭐</i><i style="--i:2">💫</i></span>
      <span class="mascot__sweat" aria-hidden="true">💦</span>
      <span class="mascot__marks" id="mascot-marks" aria-hidden="true"></span>
      <span class="mascot__stamp" id="mascot-stamp" aria-hidden="true">{t('rage.stamp')}</span>
      <span class="mascot__fx" id="mascot-fx" aria-hidden="true"></span>
    </span>
    <span class="mascot__shadow"></span>
    <span class="mascot__cta"><span class="mascot__cta-icon" aria-hidden="true">🔨</span>{t('rage.cta')}</span>
  </button>
  <RageStats lang={lang} kind="smash" />
</div>

<script>
  import '../scripts/rage';
</script>

<style>
  .mascot {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 232px;
    flex: none;
  }
  .mascot__bubble {
    margin: 0 0 6px;
    min-height: 2.7em;
    max-width: 100%;
    padding: 6px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
    overflow-wrap: anywhere;
    transition: opacity 0.25s;
  }
  .mascot__hit {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: url('/mascot/hammer.svg') 14 14, pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    border-radius: var(--radius-sm);
  }
  .mascot__hit:active {
    cursor: url('/mascot/hammer-down.svg') 12 22, pointer;
  }
  .mascot__hit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .mascot__stage {
    position: relative;
    height: 238px;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .mascot__body {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 100%;
    transform-origin: 50% 90%;
    transition:
      transform 0.15s ease-out,
      filter 0.5s;
  }
  .mascot__hit:hover .mascot__body {
    transform: translateY(-3px) scale(1.02);
  }
  .mascot__body.is-hit {
    animation: mascot-knock 0.46s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  /* streak damage: the figure gets redder and sweats, then sees stars */
  .mascot[data-hurt='2'] .mascot__body {
    filter: saturate(1.3) sepia(0.12);
  }
  .mascot[data-hurt='3'] .mascot__body {
    filter: saturate(1.8) sepia(0.3) hue-rotate(-14deg);
  }
  .mascot__fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }
  .mascot__stamp {
    position: absolute;
    inset-inline: 0;
    top: 46%;
    margin-inline: auto;
    width: max-content;
    max-width: 100%;
    padding: 2px 12px;
    border: 3px solid var(--high);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--high);
    font-family: var(--mono);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transform: rotate(-14deg) scale(1.6);
    pointer-events: none;
  }
  .mascot__stamp.is-on {
    animation: mascot-stamp 1.1s cubic-bezier(0.2, 0.9, 0.3, 1) both;
  }
  .mascot__fig {
    display: none;
    height: 232px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    transform-origin: 50% 85%;
    will-change: transform;
  }
  .mascot__shadow {
    display: block;
    width: 128px;
    height: 15px;
    border-radius: 50%;
    background: rgba(31, 30, 29, 0.13);
    filter: blur(3px);
    margin: -5px auto 0;
  }
  .mascot__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    max-width: 100%;
    margin-top: 10px;
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 2px 0 var(--accent-strong);
    color: #fff;
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    overflow-wrap: anywhere;
    transition:
      transform 0.12s,
      background 0.12s;
  }
  .mascot[data-engaged='false'] .mascot__cta {
    animation: mascot-cta 1.6s ease-in-out infinite;
  }
  .mascot__cta-icon {
    display: inline-block;
    transform-origin: 80% 80%;
    animation: mascot-cta-tap 1.6s ease-in-out infinite;
  }
  .mascot__hit:hover .mascot__cta {
    background: var(--accent-strong);
    transform: translateY(-1px);
  }
  .mascot__hit:active .mascot__cta {
    transform: translateY(2px);
    box-shadow: none;
  }
  .mascot__marks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .mascot__dizzy {
    display: none;
    position: absolute;
    top: 4px;
    inset-inline: 0;
    margin-inline: auto;
    width: 100px;
    height: 24px;
    pointer-events: none;
  }
  .mascot.is-dizzy .mascot__dizzy,
  .mascot[data-hurt='3'] .mascot__dizzy {
    display: block;
  }
  .mascot__dizzy i {
    position: absolute;
    left: 50%;
    top: 50%;
    font-style: normal;
    font-size: 1.15rem;
    line-height: 1;
    animation: mascot-orbit 1.1s linear infinite;
    animation-delay: calc(var(--i) * -0.366s);
  }
  .mascot__sweat {
    display: none;
    position: absolute;
    top: 30px;
    inset-inline-end: 34px;
    font-size: 1.3rem;
    pointer-events: none;
    animation: mascot-sweat 0.9s ease-in infinite;
  }
  .mascot[data-hurt='2'] .mascot__sweat,
  .mascot[data-hurt='3'] .mascot__sweat {
    display: block;
  }

  /* ---- state visibility + loops (pop first, then the idle loop) ---- */
  .mascot[data-state='doze'] .mascot__fig[data-mstate='doze'] {
    display: block;
    animation:
      mascot-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) both,
      mascot-doze 3.8s ease-in-out 0.32s infinite;
  }
  .mascot[data-state='search'] .mascot__fig[data-mstate='search'] {
    display: block;
    animation:
      mascot-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) both,
      mascot-search 1.9s ease-in-out 0.32s infinite;
  }
  .mascot[data-state='low'] .mascot__fig[data-mstate='low'] {
    display: block;
    animation:
      mascot-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) both,
      mascot-happy 0.95s ease-in-out 0.32s infinite;
  }
  .mascot[data-state='medium'] .mascot__fig[data-mstate='medium'] {
    display: block;
    animation:
      mascot-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) both,
      mascot-suspect 3s ease-in-out 0.32s infinite;
  }
  .mascot[data-state='high'] .mascot__fig[data-mstate='high'] {
    display: block;
    animation:
      mascot-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) both,
      mascot-gun 0.45s linear 0.32s infinite;
  }

  /* ---- Zzz bubbles, doze only ---- */
  .mascot__zzz {
    display: none;
    position: absolute;
    top: 14px;
    right: 26px;
    width: 40px;
    height: 40px;
    pointer-events: none;
  }
  .mascot[data-state='doze'] .mascot__zzz {
    display: block;
  }
  .mascot__zzz i {
    position: absolute;
    right: 6px;
    bottom: 0;
    font-style: normal;
    font-family: var(--serif);
    font-weight: 700;
    color: var(--muted-2);
    opacity: 0;
    animation: mascot-zzz 2.7s ease-out infinite;
  }
  .mascot__zzz i:nth-child(1) {
    font-size: 0.9rem;
  }
  .mascot__zzz i:nth-child(2) {
    font-size: 1.15rem;
    animation-delay: 0.9s;
  }
  .mascot__zzz i:nth-child(3) {
    font-size: 1.45rem;
    animation-delay: 1.8s;
  }

  /* ---- keyframes ---- */
  /* knock-back: red flash, squash toward the blow, then recoil */
  @keyframes mascot-knock {
    0% {
      transform: none;
      filter: brightness(1.7) saturate(2.2) hue-rotate(-18deg);
    }
    14% {
      transform: translateX(calc(var(--dir, 1) * 20px)) rotate(calc(var(--dir, 1) * 12deg)) scale(1.14, 0.76);
      filter: brightness(1.4) saturate(2.6) hue-rotate(-24deg);
    }
    38% {
      transform: translateX(calc(var(--dir, 1) * -7px)) rotate(calc(var(--dir, 1) * -6deg)) scale(0.96, 1.07);
      filter: brightness(1.15) saturate(1.7);
    }
    60% {
      transform: translateX(calc(var(--dir, 1) * 3px)) rotate(calc(var(--dir, 1) * 2.5deg));
    }
    100% {
      transform: none;
    }
  }
  @keyframes mascot-cta {
    0%,
    100% {
      box-shadow:
        0 2px 0 var(--accent-strong),
        0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent);
    }
    60% {
      box-shadow:
        0 2px 0 var(--accent-strong),
        0 0 0 10px transparent;
    }
  }
  @keyframes mascot-cta-tap {
    0%,
    55%,
    100% {
      transform: rotate(0);
    }
    70% {
      transform: rotate(-40deg);
    }
    80% {
      transform: rotate(10deg);
    }
  }
  @keyframes mascot-orbit {
    0%,
    100% {
      transform: translate(calc(-50% + 44px), -50%);
    }
    12.5% {
      transform: translate(calc(-50% + 31px), calc(-50% + 7px));
    }
    25% {
      transform: translate(-50%, calc(-50% + 10px));
    }
    37.5% {
      transform: translate(calc(-50% - 31px), calc(-50% + 7px));
    }
    50% {
      transform: translate(calc(-50% - 44px), -50%);
    }
    62.5% {
      transform: translate(calc(-50% - 31px), calc(-50% - 7px));
    }
    75% {
      transform: translate(-50%, calc(-50% - 10px));
    }
    87.5% {
      transform: translate(calc(-50% + 31px), calc(-50% - 7px));
    }
  }
  @keyframes mascot-sweat {
    0% {
      opacity: 0;
      transform: translateY(-4px);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes mascot-stamp {
    0% {
      opacity: 0;
      transform: rotate(-14deg) scale(1.6);
    }
    18% {
      opacity: 0.95;
      transform: rotate(-14deg) scale(1);
    }
    75% {
      opacity: 0.95;
      transform: rotate(-14deg) scale(1);
    }
    100% {
      opacity: 0;
      transform: rotate(-14deg) scale(1);
    }
  }
  @keyframes mascot-pop {
    0% {
      transform: scale(0.72);
      opacity: 0;
    }
    60% {
      transform: scale(1.06);
      opacity: 1;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }
  /* asleep: slow sway + breathing bob */
  @keyframes mascot-doze {
    0%,
    100% {
      transform: rotate(-1.6deg);
    }
    50% {
      transform: rotate(2.2deg) translateY(-7px);
    }
  }
  /* scanning: pans left/right like he's hunting for signals */
  @keyframes mascot-search {
    0%,
    100% {
      transform: translateX(-10px) rotate(-3.5deg);
    }
    22% {
      transform: translateX(-2px) translateY(-5px) rotate(-1deg);
    }
    50% {
      transform: translateX(10px) rotate(3.5deg);
    }
    72% {
      transform: translateX(2px) translateY(-5px) rotate(1deg);
    }
  }
  /* low risk: happy bounce */
  @keyframes mascot-happy {
    0%,
    100% {
      transform: translateY(0) rotate(-1.2deg);
    }
    28% {
      transform: translateY(-12px) rotate(1.6deg) scale(1.02);
    }
    55% {
      transform: translateY(0) rotate(0.4deg);
    }
  }
  /* medium risk: leans in and sizes you up */
  @keyframes mascot-suspect {
    0%,
    100% {
      transform: scale(1);
    }
    35% {
      transform: scale(1.07) translateY(2px);
    }
    55% {
      transform: scale(1.07) translateX(-4px) translateY(2px);
    }
    75% {
      transform: scale(1.07) translateX(4px) translateY(2px);
    }
  }
  @keyframes mascot-zzz {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(0.7);
    }
    25% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(16px, -30px) scale(1.25);
    }
  }
  /* high risk: furious trembling, gun trained on you */
  @keyframes mascot-gun {
    0%,
    100% {
      transform: scale(1.04) translate(0, 0);
    }
    15% {
      transform: scale(1.04) translate(-2px, 1px) rotate(-0.8deg);
    }
    30% {
      transform: scale(1.04) translate(2px, -1px) rotate(0.8deg);
    }
    45% {
      transform: scale(1.04) translate(-2px, -1px) rotate(-0.5deg);
    }
    60% {
      transform: scale(1.04) translate(2px, 1px) rotate(0.6deg);
    }
    80% {
      transform: scale(1.04) translate(-1px, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mascot__body.is-hit,
    .mascot__stamp.is-on,
    .mascot[data-engaged='false'] .mascot__cta,
    .mascot__cta-icon,
    .mascot__dizzy i,
    .mascot__sweat {
      animation: none;
    }
    .mascot__stamp.is-on {
      opacity: 0.95;
    }
  }

  @media (max-width: 560px) {
    .mascot {
      width: 190px;
    }
    .mascot__stage {
      height: 196px;
    }
    .mascot__fig {
      height: 190px;
    }
  }
</style>
