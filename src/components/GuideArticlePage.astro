---
import BaseLayout from '../layouts/BaseLayout.astro';
import LangToggle from './LangToggle.astro';
import SocialLinks from './SocialLinks.astro';
import AuthorByline from './AuthorByline.astro';
import Footer from './Footer.astro';
import { GUIDE_CATEGORIES, getGuide, getRelatedGuides, toIsoDate } from '../config/guides';
import { SITE_AUTHOR } from '../config/site';
import { GUIDE_CONTENT } from '../content/guidesData';
import { useTranslations, type Lang } from '../i18n/ui';
import { estimateReadMinutes, prepareArticleHtml } from '../utils/guide-html';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const guide = getGuide(slug);
const content = GUIDE_CONTENT[slug];

if (!guide || !content) {
  throw new Error(`Guide not found for slug: ${slug}`);
}

const t = useTranslations(lang);
const prefix = lang === 'zh' ? '/zh' : '';
const home = `${prefix}/`;
const guidesHub = `${prefix}/guides/`;
const newsHub = `${prefix}/news/`;
const extensionPage = `${prefix}/extension/`;
const articlePath = `${guidesHub}${slug}/`;

const title = guide.title[lang];
const summary = guide.summary[lang];
const rawHtml = content[lang];
const { html, toc } = prepareArticleHtml(rawHtml, t('guides.tableLabel'));
const readTime = t('guides.readTime').replace('{n}', String(estimateReadMinutes(rawHtml, lang)));
const relatedGuides = getRelatedGuides(guide);

const site = Astro.site ?? new URL('https://fuck-claude.vercel.app');
const currentUrl = new URL(articlePath, site).href;
const homeUrl = new URL(home, site).href;
const guidesHubUrl = new URL(guidesHub, site).href;

const jsonLdExtra = [
  {
    '@type': 'Article',
    mainEntityOfPage: currentUrl,
    headline: title,
    description: summary,
    author: {
      '@type': 'Person',
      name: SITE_AUTHOR.name,
      url: SITE_AUTHOR.githubUrl,
    },
    publisher: {
      '@type': 'Organization',
      name: 'Fuck Claude',
      url: new URL('/', site).href,
    },
    datePublished: toIsoDate(guide.publishedAt),
    dateModified: toIsoDate(guide.updatedAt),
    inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
    ...(guide.sources
      ? { citation: guide.sources.map((source) => ({ '@type': 'CreativeWork', name: source.name[lang], url: source.url })) }
      : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('nav.home'), item: homeUrl },
      { '@type': 'ListItem', position: 2, name: t('nav.guides'), item: guidesHubUrl },
      { '@type': 'ListItem', position: 3, name: title, item: currentUrl },
    ],
  },
];
---

<BaseLayout
  lang={lang}
  path={articlePath}
  title={`${title} | Fuck Claude`}
  description={summary}
  enPath={`/guides/${slug}/`}
  zhPath={`/zh/guides/${slug}/`}
  omitFaq
  jsonLdExtra={jsonLdExtra}
>
  <header class="nav">
    <div class="wrap nav__inner">
      <a class="brand" href={home}>
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="currentColor"></rect>
          <g fill="#FAF9F5">
            <rect x="26.9" y="8" width="7.6" height="29" rx="3.8"></rect>
            <rect x="18.9" y="24.5" width="6.4" height="11" rx="3.2"></rect>
            <rect x="36.1" y="24.5" width="6.4" height="11" rx="3.2"></rect>
            <rect x="16.9" y="30" width="27.6" height="24" rx="9"></rect>
            <rect x="40.6" y="32.5" width="7.6" height="16" rx="3.8" transform="rotate(-24 44.4 40.5)"></rect>
          </g>
        </svg>
        <span class="brand__text">{t('nav.title')}</span>
      </a>
      <nav class="nav__actions">
        <a class="nav__link" href={home}>{t('nav.home')}</a>
        <a class="nav__link" href={guidesHub}>{t('nav.guides')}</a>
        <a class="nav__link" href={newsHub}>{t('nav.news')}</a>
        <a class="nav__link" href={extensionPage}>{t('nav.extension')}</a>
        <LangToggle lang={lang} />
        <SocialLinks lang={lang} />
      </nav>
    </div>
  </header>

  <main class="wrap">
    <article class="article" data-lang={lang}>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={home}>{t('nav.home')}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={guidesHub}>{t('nav.guides')}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>

      <header class="article__header">
        <div class="article__meta">
          <span class="article__tag">{GUIDE_CATEGORIES[guide.category][lang]}</span>
          <span class="article__time">{readTime}</span>
        </div>
        <AuthorByline lang={lang} updatedAt={guide.updatedAt} />
        <h1>{title}</h1>
        <p class="article__lead">{summary}</p>
        <p class="article__status" data-verified={guide.verifiedAt ? 'true' : 'false'}>
          {
            guide.verifiedAt
              ? t('guides.verified').replace('{date}', guide.verifiedAt)
              : t('guides.unverified')
          }
        </p>
      </header>

      {
        toc.length >= 3 && (
          <details class="toc" open>
            <summary>{t('guides.toc')}</summary>
            <ul>
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`}>{item.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      <div class="article__body prose" set:html={html} />

      {
        guide.sources && guide.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources-title">
            <h2 id="sources-title">{t('guides.sources')}</h2>
            <ul>
              {guide.sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noopener noreferrer">
                    {source.name[lang]} ↗
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title">{t('guides.related')}</h2>
        <div class="related-grid">
          {
            relatedGuides.map((g) => (
              <a class="related-card" href={`${guidesHub}${g.slug}/`}>
                <span class="related-card__tag">{GUIDE_CATEGORIES[g.category][lang]}</span>
                <span class="related-card__title">{g.title[lang]}</span>
                <span class="related-card__sum">{g.summary[lang]}</span>
              </a>
            ))
          }
        </div>
        <a class="related-all" href={guidesHub}>{t('guides.allGuides')} →</a>
      </section>

      <footer class="article__footer">
        <a class="back-btn" href={guidesHub}>{t('guides.back')}</a>
      </footer>
    </article>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .article {
    max-width: 820px;
    margin: 0 auto;
    padding: 32px 0 60px;
  }
  .breadcrumb {
    margin-bottom: 16px;
    font-size: 0.86rem;
  }
  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: var(--muted-2);
  }
  .breadcrumb a {
    color: var(--muted);
    font-weight: 600;
  }
  .breadcrumb a:hover {
    color: var(--accent-strong);
  }
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--accent-strong);
    padding: 10px 20px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
  }
  .back-btn:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
    text-decoration: none;
  }
  .article__header {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }
  .article__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.82rem;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .article__tag {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-strong);
    background: var(--accent-soft);
    padding: 3px 10px;
    border-radius: 999px;
  }
  .article__time {
    color: var(--muted-2);
    font-family: var(--mono);
  }
  .article__header h1 {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.8vw, 2.5rem);
    line-height: 1.25;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .article__lead {
    margin: 14px 0 0;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .article__status {
    margin: 12px 0 0;
    padding: 8px 12px;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--muted);
    background: var(--surface-2);
    border-left: 3px solid var(--border-strong);
    border-radius: 4px;
  }
  .article__status[data-verified='true'] {
    border-left-color: var(--accent);
  }
  .article[data-lang='zh'] .article__lead,
  .article[data-lang='zh'] .article__status {
    line-height: 1.75;
  }
  .toc {
    margin: 0 0 28px;
    padding: 12px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .toc summary {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .toc ul {
    margin: 10px 0 0;
    padding-left: 0;
    list-style: none;
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .toc a {
    color: var(--accent-strong);
  }
  .article__body {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .article__body :global(h2) {
    font-family: var(--serif);
    font-size: 1.55rem;
    margin: 36px 0 14px;
    padding-bottom: 6px;
    border-bottom: 1px dashed var(--border-strong);
    scroll-margin-top: 80px;
  }
  .article__body :global(h3) {
    font-size: 1.18rem;
    margin: 24px 0 10px;
  }
  .article__body :global(p) {
    margin: 0 0 16px;
    color: var(--text);
  }
  .article__body :global(ul),
  .article__body :global(ol) {
    margin: 0 0 20px;
    padding-left: 24px;
  }
  .article__body :global(li) {
    margin-bottom: 8px;
  }
  .article__body :global(pre) {
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 16px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 0.88rem;
    margin: 18px 0 24px;
    overflow-wrap: normal;
  }
  .article__body :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--surface-2);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .article__body :global(pre code) {
    background: none;
    padding: 0;
    overflow-wrap: normal;
  }
  .article__body :global(.table-scroll) {
    margin: 18px 0 24px;
    overflow-x: auto;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .article__body :global(.table-scroll:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .article__body :global(table) {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .article__body :global(th),
  .article__body :global(td) {
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
    overflow-wrap: normal;
  }
  .article__body :global(thead th) {
    background: var(--surface-2);
    font-weight: 700;
    white-space: nowrap;
    border-bottom: 1px solid var(--border-strong);
  }
  .article__body :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .article__body :global(tbody tr:nth-child(even)) {
    background: color-mix(in srgb, var(--surface-2) 55%, transparent);
  }
  .sources {
    margin-top: 36px;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .sources h2 {
    font-size: 1.05rem;
    margin: 0 0 8px;
  }
  .sources ul {
    margin: 0;
    padding-left: 20px;
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .sources a {
    color: var(--accent-strong);
    font-weight: 600;
  }
  .related {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .related h2 {
    font-family: var(--serif);
    font-size: 1.4rem;
    margin: 0 0 16px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
    gap: 14px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    color: var(--text);
    overflow-wrap: anywhere;
    transition: transform 0.18s, border-color 0.18s, box-shadow 0.18s;
  }
  .related-card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: var(--shadow-md);
  }
  .related-card__tag {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-strong);
  }
  .related-card__title {
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.35;
  }
  .related-card:hover .related-card__title {
    color: var(--accent-strong);
  }
  .related-card__sum {
    font-size: 0.84rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .related-all {
    display: inline-block;
    margin-top: 18px;
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--accent-strong);
  }
  .article__footer {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: flex-start;
  }
</style>
