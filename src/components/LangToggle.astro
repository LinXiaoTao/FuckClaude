---
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/index\.html$/, '/') || '/';

/** Map current path to the other locale while preserving guide/article paths. */
function altPath(target: Lang): string {
  if (target === lang) return pathname;

  if (target === 'zh') {
    if (pathname === '/' || pathname === '') return '/zh/';
    return pathname.startsWith('/zh') ? pathname : `/zh${pathname}`;
  }

  // target === 'en'
  if (pathname === '/zh' || pathname === '/zh/') return '/';
  if (pathname.startsWith('/zh/')) {
    const rest = pathname.slice(3);
    return rest.startsWith('/') ? rest : `/${rest}`;
  }
  return pathname;
}
---

<div class="lang-toggle" role="group" aria-label="Language / 语言">
  {
    (Object.entries(languages) as [Lang, string][]).map(([code, label]) => (
      <a
        href={altPath(code)}
        hreflang={code === 'zh' ? 'zh-CN' : 'en'}
        data-lang={code}
        aria-current={code === lang ? 'page' : undefined}
      >
        {label}
      </a>
    ))
  }
</div>
