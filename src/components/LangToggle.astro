---
import { LOCALE_CODES, LOCALES, localePath, stripLocalePrefix, type Lang } from '../i18n/locales';
import { LOCALE_LABELS } from '../i18n/locale-labels';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pathname = stripLocalePrefix(Astro.url.pathname);
const suffix = pathname === '/' ? '/' : pathname.endsWith('/') ? pathname : `${pathname}/`;

function altPath(target: Lang): string {
  return localePath(target, suffix);
}
---

<details class="lang-switcher">
  <summary aria-label={t('lang.toggleLabel')}>
    {LOCALE_LABELS[lang]}
  </summary>
  <ul class="lang-switcher__menu" role="list">
    {
      LOCALE_CODES.map((code) => (
        <li>
          <a
            href={altPath(code)}
            hreflang={LOCALES[code].hreflang}
            lang={LOCALES[code].htmlLang}
            data-lang={code}
            aria-current={code === lang ? 'page' : undefined}
          >
            {LOCALE_LABELS[code]}
          </a>
        </li>
      ))
    }
  </ul>
</details>
