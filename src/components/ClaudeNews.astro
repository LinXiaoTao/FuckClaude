---
import { getLatestNews, NEWS_CATEGORIES, type NewsCategory } from '../config/news';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  limit?: number;
  showMoreLink?: boolean;
}

const { lang, limit, showMoreLink = false } = Astro.props;
const t = useTranslations(lang);
const items = getLatestNews(limit);
const newsHub = lang === 'zh' ? '/zh/news/' : '/news/';
const guidePrefix = lang === 'zh' ? '/zh/guides/' : '/guides/';

function formatDate(iso: string, locale: Lang): string {
  return new Date(iso).toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

function categoryLabel(category: NewsCategory, locale: Lang): string {
  return NEWS_CATEGORIES[category][locale];
}
---

<section class="news-block" aria-labelledby="news-block-title">
  <div class="news-block__head">
    <div>
      <h2 id="news-block-title">{t('news.title')}</h2>
      <p>{t('news.sub')}</p>
    </div>
    {
      showMoreLink && (
        <a class="nav__link" href={newsHub}>
          <span>{t('news.viewAll')} →</span>
        </a>
      )
    }
  </div>
  <ol class="news-list">
    {
      items.map((item) => (
        <li class="news-item">
          <div class="news-item__meta">
            <span class="news-item__tag" data-cat={item.category}>{categoryLabel(item.category, lang)}</span>
            <time class="news-item__date" datetime={item.publishedAt}>
              {formatDate(item.publishedAt, lang)}
            </time>
          </div>
          <h3 class="news-item__title">
            <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
              {item.title[lang]}
            </a>
          </h3>
          <p class="news-item__summary">{item.summary[lang]}</p>

          {item.takeaway && (
            <div class="news-item__takeaway">
              <span class="news-item__takeaway-label">{lang === 'zh' ? '实战要点：' : 'Takeaway:'}</span>
              <span>{item.takeaway[lang]}</span>
            </div>
          )}

          <div class="news-item__foot">
            <span class="news-item__source">
              {t('news.source')}: <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceName} ↗</a>
            </span>
            {item.relatedGuideSlug && (
              <a class="news-item__guide" href={`${guidePrefix}${item.relatedGuideSlug}/`}>
                {lang === 'zh' ? '相关实战指南 →' : 'Related Guide →'}
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .news-block__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 4px;
  }
  .news-block__head h2 {
    font-family: var(--serif);
    font-size: 1.55rem;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }
  .news-block__head p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .news-list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .news-item {
    padding: 20px 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    overflow-wrap: anywhere;
    transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
  }
  .news-item:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }
  .news-item__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .news-item__tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-strong);
    background: var(--accent-soft);
    padding: 3px 10px;
    border-radius: 999px;
  }
  .news-item__tag[data-cat='product'] {
    color: #2b6cb0;
    background: rgba(43, 108, 176, 0.1);
  }
  .news-item__tag[data-cat='api'] {
    color: #2f855a;
    background: rgba(47, 133, 90, 0.1);
  }
  .news-item__tag[data-cat='security'] {
    color: #c53030;
    background: rgba(197, 48, 48, 0.1);
  }
  .news-item__tag[data-cat='policy'] {
    color: #805ad5;
    background: rgba(128, 90, 213, 0.1);
  }
  .news-item__date {
    font-size: 0.78rem;
    color: var(--muted-2);
    font-family: var(--mono);
  }
  .news-item__title {
    font-size: 1.08rem;
    margin: 0 0 8px;
    line-height: 1.35;
  }
  .news-item__title a {
    color: var(--text);
  }
  .news-item__title a:hover {
    color: var(--accent-strong);
    text-decoration: none;
  }
  .news-item__summary {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 10px;
  }
  .news-item__takeaway {
    margin: 8px 0 12px;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--bg-soft);
    border-left: 3px solid var(--accent);
    font-size: 0.86rem;
    color: var(--text);
    line-height: 1.5;
  }
  .news-item__takeaway-label {
    font-weight: 700;
    color: var(--accent-strong);
    margin-right: 4px;
  }
  .news-item__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 8px;
    border-top: 1px dashed var(--border);
  }
  .news-item__source {
    font-size: 0.78rem;
    color: var(--muted-2);
  }
  .news-item__source a {
    color: var(--muted);
  }
  .news-item__source a:hover {
    color: var(--accent-strong);
  }
  .news-item__guide {
    font-size: 0.82rem;
    font-weight: 650;
    color: var(--accent-strong);
  }
  .news-item__guide:hover {
    text-decoration: underline;
  }
</style>
