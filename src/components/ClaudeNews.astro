---
import { getLatestNews, NEWS_CATEGORIES, type NewsCategory } from '../config/news';
import { LOCALES, localePath, type Lang } from '../i18n/locales';
import { localize } from '../i18n/localize';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  limit?: number;
  showMoreLink?: boolean;
  categories?: NewsCategory[];
  title?: string;
  sub?: string;
}

const { lang, limit, showMoreLink = false, categories, title, sub } = Astro.props;
const t = useTranslations(lang);
const items = getLatestNews(limit, categories);
const newsHub = localePath(lang, '/news/');
const guidePrefix = localePath(lang, '/guides/');

function formatDate(iso: string, locale: Lang): string {
  const tag = LOCALES[locale].htmlLang;
  return new Date(iso).toLocaleDateString(tag, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

function categoryLabel(category: NewsCategory, locale: Lang): string {
  return localize(NEWS_CATEGORIES[category], locale);
}
---

<section class="news-block" aria-labelledby="news-block-title">
  <div class="news-block__head">
    <div>
      <h2 id="news-block-title">{title ?? t('news.title')}</h2>
      <p>{sub ?? t('news.sub')}</p>
    </div>
    {
      showMoreLink && (
        <a class="nav__link" href={newsHub}>
          <span>{t('news.viewAll')} →</span>
        </a>
      )
    }
  </div>
  <ol class="news-list">
    {
      items.map((item) => (
        <li class="news-item">
          <div class="news-item__meta">
            <span class="news-item__tag" data-cat={item.category}>{categoryLabel(item.category, lang)}</span>
            <time class="news-item__date" datetime={item.publishedAt}>
              {formatDate(item.publishedAt, lang)}
            </time>
          </div>
          <h3 class="news-item__title">
            <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
              {localize(item.title, lang)}
            </a>
          </h3>
          <p class="news-item__summary">{localize(item.summary, lang)}</p>

          {item.takeaway && (
            <div class="news-item__takeaway">
              <span class="news-item__takeaway-label">{t('community.takeaway')}</span>
              <span>{localize(item.takeaway, lang)}</span>
            </div>
          )}

          <div class="news-item__foot">
            <span class="news-item__source">
              {t('news.source')}: <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{item.sourceName} ↗</a>
            </span>
            {item.relatedGuideSlug && (
              <a class="news-item__guide" href={`${guidePrefix}${item.relatedGuideSlug}/`}>
                {t('community.relatedGuide')} →
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .news-block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }
  .news-block__head h2 {
    font-family: var(--serif);
    font-size: 1.35rem;
    margin: 0 0 4px;
  }
  .news-block__head p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    max-width: 62ch;
  }
  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .news-item {
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow-wrap: anywhere;
  }
  .news-item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    font-size: 0.78rem;
    color: var(--muted-2);
  }
  .news-item__tag {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.68rem;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--bg);
  }
  .news-item__title {
    margin: 0 0 8px;
    font-size: 1.02rem;
    line-height: 1.35;
  }
  .news-item__summary {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .news-item__takeaway {
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: var(--bg-soft);
    font-size: 0.86rem;
    color: var(--muted);
  }
  .news-item__takeaway-label {
    font-weight: 700;
    color: var(--text);
    margin-inline-end: 6px;
  }
  .news-item__foot {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    font-size: 0.82rem;
    color: var(--muted-2);
  }
  .news-item__guide {
    font-weight: 650;
    white-space: nowrap;
  }
</style>
