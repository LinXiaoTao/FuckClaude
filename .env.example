# Server-only keys for the IP purity check (`/api/ip`).
# Leave a key empty to skip that source. If all three are empty, the endpoint
# still returns the visitor IP and ipwho.is geo, and it does not invent a high
# purity score. Set these in the Vercel project. Never prefix them with PUBLIC_.

# https://ipapi.is — optional; a missing key still tries a low-rate keyless lookup
IPAPI_IS_KEY=

# https://proxycheck.io
PROXYCHECK_API_KEY=

# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
