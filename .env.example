# Server-only keys for the IP purity check (`/api/ip`).
# Leave a key empty to skip that source. If both are empty, the endpoint
# still returns the visitor IP and ipwho.is geo, and it does not invent a high
# purity score. Geo/ASN/org falls back to ipwho.is (no key). Set these in the
# Vercel project. Never prefix them with PUBLIC_.

# https://proxycheck.io
PROXYCHECK_API_KEY=

# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
