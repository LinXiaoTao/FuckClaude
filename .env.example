# Server-only keys for the IP purity check (`/api/ip`).
# Leave a key empty to skip that source. If both are empty, the endpoint
# still returns the visitor IP and ipwho.is geo, and it does not invent a high
# purity score. Geo/ASN/org falls back to ipwho.is (no key). Set these in the
# Vercel project. Never prefix them with PUBLIC_.

# https://proxycheck.io
PROXYCHECK_API_KEY=

# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Global smash and scan counters (`/api/stats`). Injected by the Vercel
# Marketplace integration "Upstash for Redis" (`vercel integration add upstash/upstash-kv`).
# Without them the counters stay local to the visitor's browser.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as alternatives.
KV_REST_API_URL=
KV_REST_API_TOKEN=
